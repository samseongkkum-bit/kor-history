{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/make-config.mjs",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/host", "destination": "/host/index.html" },
    { "source": "/play", "destination": "/play/index.html" },
    { "source": "/solo", "destination": "/solo/index.html" }
  ],
  "headers": [
    {
      "source": "/config.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
